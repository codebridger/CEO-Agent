# Copy this file to .env and fill in the values for your deployment:
#   cp .env.example .env
# These ClickUp ids are workspace-specific config, not secrets. Real secrets
# added in later milestones (e.g. the webhook signing secret) also live here.

# ClickUp workspace ("team") id — the digits in your workspace URL.
CLICKUP_WORKSPACE_ID=9018800487

# ClickUp user ids (loop guard + delegation).
# Aso Dara is the account the agent speaks as.
ASO_USER_ID=113552267
NAVID_USER_ID=78238611
SOMI_USER_ID=78238620

# Chat channels.
# NAVID_DM_CHANNEL_ID = private chat with Navid (PRD §6.2).
NAVID_DM_CHANNEL_ID=8crzyb7-1458
# PUBLIC_CHANNEL_ID = the Subturtle.app public group chat.
PUBLIC_CHANNEL_ID=6-901805492347-8

# Task lists.
SUBTURTLE_APP_LIST_ID=901805492347

# Model tiers (optional; default sonnet / opus).
MODEL_PM=sonnet
MODEL_HEARTBEAT=opus

# --- M2: webhook listener + chat poller ---
# ClickUp personal API token for the agent's account (SECRET — fill in your .env,
# never commit). Settings → Apps → API Token. Used ONLY for webhook register/list
# and the cheap chat poll, never for acting on the business.
CLICKUP_API_TOKEN=pk_xxxxxxxx

# Public HTTPS URL ClickUp posts events to (your Cloudflare-proxied subdomain).
WEBHOOK_PUBLIC_URL=https://aso.example.com/clickup/webhook
# Path the listener serves (must match the path in WEBHOOK_PUBLIC_URL).
WEBHOOK_PATH=/clickup/webhook
# Origin port (443 in prod, behind Cloudflare "Full"). Self-signed cert in data/tls/.
PORT=443
TLS_CERT_PATH=data/tls/origin.crt
TLS_KEY_PATH=data/tls/origin.key

# Chat poll cadence (ms) — ClickUp has no chat webhook, so DMs are polled.
POLL_INTERVAL_MS=90000
# Compact a thread file once it grows past this many bytes.
THREAD_COMPACT_BYTES=24000
# The webhook signing secret is NOT here — `npm run webhook -- register` writes
# it to data/webhooks.json (git-ignored).
