# Copy this file to .env and fill in the values for your deployment:
#   cp .env.example .env
# These ClickUp ids are workspace-specific config, not secrets. Real secrets
# added in later milestones (e.g. the webhook signing secret) also live here.

# ClickUp workspace ("team") id — the digits in your workspace URL.
CLICKUP_WORKSPACE_ID=9018800487

# ClickUp user ids (loop guard + delegation).
# Aso Dara is the account the agent speaks as.
ASO_USER_ID=113552267
NAVID_USER_ID=78238611
SOMI_USER_ID=78238620

# Chat channels.
# NAVID_DM_CHANNEL_ID = private chat with Navid (PRD §6.2).
NAVID_DM_CHANNEL_ID=8crzyb7-1458
# PUBLIC_CHANNEL_ID = the Subturtle.app public group chat.
PUBLIC_CHANNEL_ID=6-901805492347-8

# Task lists.
SUBTURTLE_APP_LIST_ID=901805492347

# Model tiers (optional; default sonnet / opus).
MODEL_PM=sonnet
MODEL_HEARTBEAT=opus
